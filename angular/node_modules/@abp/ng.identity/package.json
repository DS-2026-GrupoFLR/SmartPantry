{
  "name": "@abp/ng.identity",
  "version": "10.6.1",
  "homepage": "https://abp.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/abpframework/abp.git"
  },
  "dependencies": {
    "@abp/ng.components": "~10.6.1",
    "@abp/ng.permission-management": "~10.6.1",
    "@abp/ng.theme.shared": "~10.6.1",
    "tslib": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "fesm2022/abp-ng.identity.mjs",
  "typings": "types/abp-ng.identity.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/abp-ng.identity.d.ts",
      "default": "./fesm2022/abp-ng.identity.mjs"
    },
    "./config": {
      "types": "./types/abp-ng.identity-config.d.ts",
      "default": "./fesm2022/abp-ng.identity-config.mjs"
    },
    "./proxy": {
      "types": "./types/abp-ng.identity-proxy.d.ts",
      "default": "./fesm2022/abp-ng.identity-proxy.mjs"
    }
  },
  "sideEffects": false,
  "type": "module"
}