  },
  "peerDependencies": {
    "@abp/ng.core": ">=10.6.1",
    "@abp/ng.theme.shared": ">=10.6.1"
  },
  "dependencies": {
    "chart.js": "^3.5.1",
    "ng-zorro-antd": "~21.3.1",
    "@ctrl/tinycolor": "^4.0.0",
    "tslib": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "LGPL-3.0",
  "keywords": [
    "aspnetcore",
    "boilerplate",
    "framework",
    "web",
    "best-practices",
    "angular",
    "maui",
    "blazor",
    "mvc",
    "csharp",
    "webapp"
  ],
  "module": "fesm2022/abp-ng.components.mjs",
  "typings": "types/abp-ng.components.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/abp-ng.components.d.ts",
      "default": "./fesm2022/abp-ng.components.mjs"
    },
    "./chart.js": {
      "types": "./types/abp-ng.components-chart.js.d.ts",
      "default": "./fesm2022/abp-ng.components-chart.js.mjs"
    },
    "./dynamic-form": {
      "types": "./types/abp-ng.components-dynamic-form.d.ts",
      "default": "./fesm2022/abp-ng.components-dynamic-form.mjs"
    },
    "./extensible": {
      "types": "./types/abp-ng.components-extensible.d.ts",
      "default": "./fesm2022/abp-ng.components-extensible.mjs"
    },
    "./lookup": {
      "types": "./types/abp-ng.components-lookup.d.ts",
      "default": "./fesm2022/abp-ng.components-lookup.mjs"
    },
    "./page": {
      "types": "./types/abp-ng.components-page.d.ts",
      "default": "./fesm2022/abp-ng.components-page.mjs"
    },
    "./tree": {
      "types": "./types/abp-ng.components-tree.d.ts",
      "default": "./fesm2022/abp-ng.components-tree.mjs"
    }
  },
  "sideEffects": false,
  "type": "module"
}