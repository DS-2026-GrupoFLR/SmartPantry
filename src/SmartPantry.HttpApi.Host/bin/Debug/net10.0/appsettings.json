{
  "App": {
    "SelfUrl": "https://localhost:44387",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.SmartPantry.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=<SmartPantry>;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AuthServer": {
    "Authority": "https://localhost:44387",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "SmartPantry_Swagger",
    "CertificatePassPhrase": "12f70f4f-5fc2-4d4e-a6e6-45f00b598a28"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "8LqhCScTbAodiymV"
  }}